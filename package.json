{
  "name": "spotify-stats",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev:web": "pnpm --filter @spotify-stats/web dev",
    "dev:ingest": "pnpm --filter @spotify-stats/ingest dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @spotify-stats/db db:generate",
    "db:migrate": "pnpm --filter @spotify-stats/db db:migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate:local": "pnpm --filter @spotify-stats/db exec tsx scripts/local.ts",
    "db:seed": "pnpm --filter @spotify-stats/db exec tsx scripts/local.ts seed",
    "test:db": "pnpm --filter @spotify-stats/db exec tsx scripts/test.ts",
    "dev:local": "pnpm db:up && pnpm db:seed && WATCHPACK_POLLING=true DATABASE_URL=postgresql://spotify:spotify@127.0.0.1:55432/spotify_stats_dev pnpm dev:web"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
